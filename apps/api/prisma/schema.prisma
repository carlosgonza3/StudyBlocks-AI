generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


model Course {
  id          String   @id @default(uuid())
  title       String
  description String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  studyGuide StudyGuide?
  sourceDocuments SourceDocument[]

  @@index([ownerId])
  @@map("courses")
}

enum SourceDocumentStatus {
  PROCESSING
  READY
  FAILED
}

model SourceDocument {
  id            String               @id @default(uuid())
  courseId      String
  originalName  String
  storedName    String
  mimeType      String
  sizeBytes     Int
  storagePath   String
  extractedText String               @default("")
  status        SourceDocumentStatus @default(PROCESSING)
  errorMessage  String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("source_documents")
}


model StudyGuide {
  id                String    @id @default(uuid())
  title             String
  contentMarkdown   String    @default("")
  courseId          String    @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("study_guides")
}
